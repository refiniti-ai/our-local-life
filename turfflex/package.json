{
  "name": "turfflex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "node -e \"const fs=require('fs'); const p='.next'; if(fs.existsSync(p)) fs.rmSync(p,{recursive:true,force:true}); console.log('Cleaned .next');\"",
    "run": "npm run clean && npm run build && npm start",
    "sync-functions": "node scripts/sync-to-functions.js",
    "build-functions": "node scripts/build-functions.js",
    "build:firebase": "npm run build && npm run sync-functions && npm run build-functions",
    "deploy:live": "npm run build:firebase && firebase deploy",
    "build:preview": "node scripts/build-static-preview.js",
    "allow-public-access": "node scripts/allow-public-invoker.js"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^14.14.0",
    "@stripe/stripe-js": "^2.4.0",
    "@stripe/react-stripe-js": "^2.4.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.454.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  }
}
